<ResourceDictionary
    x:Class="UnoDock.Gallery.GalleryChromeResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnoDock.Gallery">
  <!-- Native WinUI checks a Style's TargetType through the app's XAML type metadata, which
       only describes types that appear in markup. Naming the code-only manager subclass here
       lets DockingManager styles apply to it (see docs/native-winui.md). -->
  <Style x:Key="Gallery.ManagerTypeMetadata" TargetType="local:GalleryDockingManager" />
  <!-- Keep stock Uno/WinUI templates, keyboard states and automation peers. -->
  <Style x:Key="Gallery.ToolbarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>
  <Style x:Key="Gallery.Selector" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="8,2,0,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style x:Key="Gallery.Surface" TargetType="Grid">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
  </Style>
  <Style x:Key="Gallery.Status" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <DataTemplate x:Key="Gallery.Icon.new">
    <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" IsHitTestVisible="False" />
  </DataTemplate>
  <DataTemplate x:Key="Gallery.Icon.save">
    <FontIcon Glyph="&#xE74E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" IsHitTestVisible="False" />
  </DataTemplate>
  <DataTemplate x:Key="Gallery.Icon.restore">
    <FontIcon Glyph="&#xE777;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" IsHitTestVisible="False" />
  </DataTemplate>
  <DataTemplate x:Key="Gallery.Icon.float">
    <FontIcon Glyph="&#xE8A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" IsHitTestVisible="False" />
  </DataTemplate>
  <!-- DocumentPaneMenuItemHeaderTemplate: one row of the open-documents list.
       The data context is the listed LayoutDocument. -->
  <DataTemplate x:Key="Gallery.DocumentMenuItem">
    <Grid ColumnSpacing="8" Padding="0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Source="{Binding IconSource}" Width="16" Height="16" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding ContentId}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
