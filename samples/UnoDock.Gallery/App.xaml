<Application x:Class="UnoDock.Gallery.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:UnoDock.Controls">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <DataTemplate x:Key="NoteTemplate">
    <Grid Padding="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Title}" FontSize="24" Margin="0,0,0,16" />
     <TextBox Grid.Row="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" />
    </Grid>
   </DataTemplate>
   <Style x:Key="NoteItemStyle" TargetType="controls:LayoutItem">
    <Setter Property="Title" Value="{Binding Title}"/><Setter Property="ContentId" Value="{Binding ContentId}"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
