<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dock="using:UnoDock" xmlns:layout="using:UnoDock.Layout" xmlns:themes="using:UnoDock.Themes" xmlns:gallery="using:UnoDock.Gallery" x:Class="UnoDock.Gallery.XamlSamplesPage">
    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="8" Spacing="4">
            <TextBlock Text="XAML workspaces" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="AvalonDock layout conventions. Uno binding, templates, semantic colors and retained editor views." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Pivot Grid.Row="1">
            <PivotItem Header="Declarative layout">
                <gallery:XamlDeclarativeWorkspace x:Name="Declarative"/>
            </PivotItem>
            <PivotItem Header="MVVM bindings">
                <gallery:XamlMvvmWorkspace x:Name="Mvvm"/>
            </PivotItem>
            <PivotItem Header="Templates">
                <gallery:XamlTemplateWorkspace x:Name="Templates"/>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
