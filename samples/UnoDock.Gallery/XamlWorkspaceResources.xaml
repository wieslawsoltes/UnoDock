<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gallery="using:UnoDock.Gallery" xmlns:controls="using:UnoDock.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="XamlSample.CanvasBrush" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="XamlSample.CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="XamlSample.StrokeBrush" Color="#D6D6D6"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="XamlSample.CanvasBrush" Color="#202020"/>
            <SolidColorBrush x:Key="XamlSample.CardBrush" Color="#292929"/>
            <SolidColorBrush x:Key="XamlSample.StrokeBrush" Color="#484848"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="XamlSample.CanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="XamlSample.CardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="XamlSample.StrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <DataTemplate x:Key="XamlSample.HeaderTemplate">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <FontIcon Glyph="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="XamlSample.DocumentTemplate">
        <gallery:XamlDocumentView/>
    </DataTemplate>
    <DataTemplate x:Key="XamlSample.ToolTemplate">
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </DataTemplate>
    <gallery:XamlWorkspaceTemplateSelector x:Key="XamlSample.TemplateSelector" DocumentTemplate="{StaticResource XamlSample.DocumentTemplate}" ToolTemplate="{StaticResource XamlSample.ToolTemplate}"/>
    <Style x:Key="XamlSample.ItemStyle" TargetType="controls:LayoutItem">
        <Setter Property="controls:LayoutItemBindings.Title">
            <Setter.Value>
                <controls:LayoutBinding Path="Title" Mode="TwoWay"/>
            </Setter.Value>
        </Setter>
        <Setter Property="controls:LayoutItemBindings.ContentId">
            <Setter.Value>
                <controls:LayoutBinding Path="ContentId" Mode="OneWay"/>
            </Setter.Value>
        </Setter>
        <Setter Property="controls:LayoutItemBindings.CanClose">
            <Setter.Value>
                <controls:LayoutBinding Path="CanClose" Mode="TwoWay"/>
            </Setter.Value>
        </Setter>
        <Setter Property="controls:LayoutItemBindings.IsSelected">
            <Setter.Value>
                <controls:LayoutBinding Path="IsSelected" Mode="TwoWay"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
