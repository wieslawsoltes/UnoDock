<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dock="using:UnoDock" xmlns:layout="using:UnoDock.Layout" xmlns:themes="using:UnoDock.Themes" xmlns:gallery="using:UnoDock.Gallery" x:Class="UnoDock.Gallery.XamlTemplateWorkspace">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="XamlWorkspaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <themes:ResourceDictionaryTheme x:Key="OceanDockTheme">
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#F3F8FC"/>
                            <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#EAF2F8"/>
                            <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#DFEAF4"/>
                            <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#B4C8DB"/>
                            <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#172A3A"/>
                            <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#D4E8F8"/>
                            <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#BEDCEF"/>
                            <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#005A85"/>
                            <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#DCECF7"/>
                            <x:Double x:Key="UnoDock.FontSize">13</x:Double>
                            <x:Double x:Key="UnoDock.TabHeight">34</x:Double>
                            <x:Double x:Key="UnoDock.TitleHeight">30</x:Double>
                            <x:Double x:Key="UnoDock.CornerRadius">6</x:Double>
                            <x:Double x:Key="UnoDock.ButtonSize">24</x:Double>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#162531"/>
                            <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#1A2E3C"/>
                            <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#243B4B"/>
                            <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#48667D"/>
                            <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#EDF7FF"/>
                            <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#294D67"/>
                            <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#35627F"/>
                            <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#73D4FF"/>
                            <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#244257"/>
                            <x:Double x:Key="UnoDock.FontSize">13</x:Double>
                            <x:Double x:Key="UnoDock.TabHeight">34</x:Double>
                            <x:Double x:Key="UnoDock.TitleHeight">30</x:Double>
                            <x:Double x:Key="UnoDock.CornerRadius">6</x:Double>
                            <x:Double x:Key="UnoDock.ButtonSize">24</x:Double>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                            <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                            <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                            <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                            <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                            <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                            <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                            <x:Double x:Key="UnoDock.FontSize">13</x:Double>
                            <x:Double x:Key="UnoDock.TabHeight">34</x:Double>
                            <x:Double x:Key="UnoDock.TitleHeight">30</x:Double>
                            <x:Double x:Key="UnoDock.CornerRadius">6</x:Double>
                            <x:Double x:Key="UnoDock.ButtonSize">24</x:Double>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </themes:ResourceDictionaryTheme>
            <ControlTemplate x:Key="OutlinedDockTemplate" TargetType="dock:DockingManager">
                <Border x:Name="CustomFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <Grid x:Name="PART_AutoHideArea">
                        <ContentPresenter x:Name="PART_LayoutHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Grid>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="InsetDockTemplate" TargetType="dock:DockingManager">
                <Grid Padding="{TemplateBinding Padding}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="12"/>
                    <Grid x:Name="PART_AutoHideArea" Margin="8">
                        <ContentPresenter x:Name="PART_LayoutHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{ThemeResource XamlSample.CanvasBrush}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
            <AppBarButton Label="Swap control template" Icon="Switch" Click="OnSwapTemplate"/>
            <AppBarButton Label="Replace bound content" Icon="Refresh" Click="OnReplaceContent"/>
            <AppBarButton Label="Theme" Icon="Setting" Command="{x:Bind Actions.ToggleThemeCommand}"/>
            <AppBarButton Label="Density" Icon="ViewAll" Command="{x:Bind Actions.CycleDensityCommand}"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Toggle XAML palette" Click="OnTogglePalette"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <dock:DockingManager x:Name="Dock" Grid.Row="1" Margin="8,0" Padding="8" BorderThickness="1" CornerRadius="8" BorderBrush="{ThemeResource XamlSample.StrokeBrush}" Background="{ThemeResource XamlSample.CardBrush}" Template="{StaticResource OutlinedDockTemplate}" FloatingWindowMode="InSurface" LayoutItemTemplate="{StaticResource XamlSample.DocumentTemplate}" DocumentHeaderTemplate="{StaticResource XamlSample.HeaderTemplate}">
            <dock:DockingManager.Theme>
                <themes:FluentTheme Density="Comfortable"/>
            </dock:DockingManager.Theme>
            <layout:LayoutRoot>
                <layout:LayoutPanel>
                    <layout:LayoutDocumentPaneGroup>
                        <layout:LayoutDocumentPane>
                            <layout:LayoutDocument x:Name="BoundDocument" ContentId="template-document" IsActive="True" Title="{x:Bind ViewModel.PrimaryItem.Title, Mode=OneWay}" Content="{x:Bind ViewModel.PrimaryItem, Mode=OneWay}"/>
                        </layout:LayoutDocumentPane>
                    </layout:LayoutDocumentPaneGroup>
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>
        <TextBlock Grid.Row="2" Margin="12,2,12,8" Text="{x:Bind Actions.Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
