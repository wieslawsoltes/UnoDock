<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UnoDock.Gallery.XamlDensityPicker">
  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
    <TextBlock Text="Density" FontSize="12" VerticalAlignment="Center"/>
    <ComboBox x:Name="Choices" Width="140" MinHeight="28" FontSize="12" SelectionChanged="SelectionChanged" AutomationProperties.AutomationId="XamlDensityPicker" AutomationProperties.Name="Docking chrome density">
      <ComboBoxItem Content="Resource default"/>
      <ComboBoxItem Content="Compact"/>
      <ComboBoxItem Content="Comfortable"/>
      <ComboBoxItem Content="Spacious"/>
    </ComboBox>
  </StackPanel>
</UserControl>
