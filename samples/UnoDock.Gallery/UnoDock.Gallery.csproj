<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(UnoDockTargetFrameworks)' == ''">net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(UnoDockTargetFrameworks)' != ''">$(UnoDockTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <IsPackable>false</IsPackable>
    <ApplicationTitle>UnoDock Gallery</ApplicationTitle>
    <ApplicationId>org.unodock.gallery</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>UnoDock contributors</ApplicationPublisher>
    <ApplicationDescription>Classic WPF-style docking on Uno Platform</ApplicationDescription>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
  </PropertyGroup>
  <!-- Native WinUI 3 head, requested explicitly with
       -p:UnoDockTargetFrameworks=net10.0-windows10.0.26100.0 and built with Visual Studio MSBuild:
       an unpackaged, self-contained Windows App SDK app that runs every sample and suite. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <OutputType>WinExe</OutputType>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <!-- Browser workspaces exist only on WebAssembly; their library targets Uno alone. -->
    <Compile Remove="App.Browser.cs;BrowserWorkspacePage.xaml.cs;BrowserTextView.xaml.cs;BrowserTextViewFactory.cs" />
    <Page Remove="BrowserWorkspacePage.xaml;BrowserTextView.xaml" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm' and '$(Configuration)' == 'Release'">
    <!-- Use the execution mode exercised by the native startup/recovery tests.
         AOT does not waive the separate multi-window lifecycle acceptance gate. -->
    <WasmShellMonoRuntimeExecutionMode>InterpreterAndAOT</WasmShellMonoRuntimeExecutionMode>
    <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/UnoDock.VisualTests/*.cs" Link="Testing/%(Filename)%(Extension)" />
    <Compile Include="../../tools/VisualScene/SceneContent.cs" Link="Testing/SceneContent.cs" />
    <EmbeddedResource Include="../../contracts/visual-fixtures/*.xml" LogicalName="VisualFixtures.%(Filename)%(Extension)" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/InputExtensionTests.cs" Link="Testing/InputExtensionTests.cs" />
    <ProjectReference Include="../../src/UnoDock/UnoDock.csproj" />
    <ProjectReference Include="../../src/UnoDock.Browser/UnoDock.Browser.csproj" Condition="!$(TargetFramework.Contains('-windows'))" />
    <ProjectReference Include="../../src/UnoDock.Themes.Aero/UnoDock.Themes.Aero.csproj" />
    <ProjectReference Include="../../src/UnoDock.Themes.Metro/UnoDock.Themes.Metro.csproj" />
    <ProjectReference Include="../../src/UnoDock.Themes.VS2010/UnoDock.Themes.VS2010.csproj" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/ShellTests*.cs" Link="Testing/%(Filename)%(Extension)" />
    <Compile Include="../../tests/UnoDock.Testing/Check.cs" Link="Testing/Check.cs" />
    <Compile Include="../../tests/UnoDock.Testing/TestRunner.cs" Link="Testing/TestRunner.cs" />
    <Compile Include="../../tests/UnoDock.Testing/TestWindows.cs" Link="Testing/TestWindows.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/WindowLifecycleTests.cs" Link="Testing/WindowLifecycleTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/RuntimeTests.cs" Link="Testing/RuntimeTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/InteropTests.cs" Link="Testing/InteropTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/ReferenceBehaviorTests.cs" Link="Testing/ReferenceBehaviorTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/ParityTests.cs" Link="Testing/ParityTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/LifecycleTests.cs" Link="Testing/LifecycleTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/RestoreOwnershipTests.cs" Link="Testing/RestoreOwnershipTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/InteractionTests.cs" Link="Testing/InteractionTests.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/X11TestInput.cs" Link="Testing/X11TestInput.cs" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/WindowCoordinateTests*.cs" Link="Testing/%(Filename)%(Extension)" />
    <Compile Include="../../tests/UnoDock.Runtime.Tests/ConverterTests*.cs" Link="Testing/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../contracts/converter-fixtures/*.xml" LogicalName="ConverterFixtures.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../contracts/reference-fixtures/*.xml" LogicalName="ReferenceFixtures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
