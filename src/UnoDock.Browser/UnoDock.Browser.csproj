<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>UnoDock.Browser</PackageId>
    <Description>Lease-checked browser window hosting for UnoDock with application-owned content factories.</Description>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnoDock/UnoDock.csproj" />
    <None Update="Assets/*.mjs" Pack="true" PackagePath="contentFiles/any/any/UnoDock.Browser/" />
  </ItemGroup>
</Project>
