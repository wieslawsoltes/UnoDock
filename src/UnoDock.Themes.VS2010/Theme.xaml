<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Navy IDE workbench: light text on the workspace, gold active captions,
         gold active document tab and a gold frame around the active document
         pane. Independently authored palette. -->
    <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#2C3D5A" />
    <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#3B4F71" />
    <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#8E9BBC" />
    <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="#3E4A5E" />
    <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="#8C95A6" />
    <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#FFF0C2" />
    <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#FFE08A" />
    <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#E5C365" />
    <LinearGradientBrush x:Key="UnoDock.ActiveTitleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFBED" />
        <GradientStop Offset="1" Color="#FFE8A6" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="UnoDock.WorkspaceBrush" Color="#2C3D5A" />
    <SolidColorBrush x:Key="UnoDock.SplitterBrush" Color="#2C3D5A" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabStripBrush" Color="#2C3D5A" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabBrush" Color="#002C3D5A" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabForegroundBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="UnoDock.SelectedDocumentTabBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FCFCFD" />
        <GradientStop Offset="1" Color="#D5DCE8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UnoDock.SelectedDocumentTabForegroundBrush" Color="#000000" />
    <LinearGradientBrush x:Key="UnoDock.ActiveDocumentTabBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFCF0" />
        <GradientStop Offset="1" Color="#FFE8A6" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UnoDock.TabHoverBrush" Color="#5B7199" />
    <SolidColorBrush x:Key="UnoDock.PaneBorderBrush" Color="#8E9BBC" />
    <SolidColorBrush x:Key="UnoDock.ActiveDocumentPaneBorderBrush" Color="#FFE8A6" />
    <x:Double x:Key="UnoDock.ActiveDocumentPaneBorderThickness">2</x:Double>
    <SolidColorBrush x:Key="UnoDock.TabBorderBrush" Color="#002C3D5A" />
    <x:Double x:Key="UnoDock.TabHorizontalPadding">5</x:Double>

    <LinearGradientBrush x:Key="UnoDock.ToolTitleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D6082" />
        <GradientStop Offset="1" Color="#3D5277" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UnoDock.ToolTitleForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.ActiveToolTitleForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="UnoDock.ToolTabStripBrush" Color="#2C3D5A" />
    <SolidColorBrush x:Key="UnoDock.ToolTabBrush" Color="#002C3D5A" />
    <SolidColorBrush x:Key="UnoDock.ToolTabForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.SelectedToolTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.SelectedToolTabForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="UnoDock.RailBrush" Color="#2C3D5A" />
    <SolidColorBrush x:Key="UnoDock.AnchorTabBrush" Color="#435779" />
    <SolidColorBrush x:Key="UnoDock.AnchorTabForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.FloatingBorderBrush" Color="#3D5277" />
    <SolidColorBrush x:Key="UnoDock.ActiveFloatingBorderBrush" Color="#FFE8A6" />

    <x:Double x:Key="UnoDock.TitleHeight">21</x:Double>
    <x:Double x:Key="UnoDock.TabHeight">22</x:Double>
    <x:Double x:Key="UnoDock.ToolTabHeight">23</x:Double>
</ResourceDictionary>
