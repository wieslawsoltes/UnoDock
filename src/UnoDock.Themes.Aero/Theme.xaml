<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Glassy blue workbench: gradient captions, slanted document tabs and a
         bold selected document title. Independently authored palette. -->
    <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#EBEEFA" />
    <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#E3EAF5" />
    <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#898C95" />
    <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="#5A5E66" />
    <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="#9A9DA3" />
    <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#D6E6F9" />
    <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#B9D3F1" />
    <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#3D7BD9" />
    <LinearGradientBrush x:Key="UnoDock.ActiveTitleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#9FBDE5" />
        <GradientStop Offset="1" Color="#D3E3F7" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="UnoDock.WorkspaceBrush" Color="#EBEEFA" />
    <SolidColorBrush x:Key="UnoDock.SplitterBrush" Color="#E1E9F7" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabStripBrush" Color="#F1F4FB" />
    <LinearGradientBrush x:Key="UnoDock.DocumentTabBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EEF3FA" />
        <GradientStop Offset="1" Color="#A8C0DA" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UnoDock.SelectedDocumentTabBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FDFEFF" />
        <GradientStop Offset="1" Color="#D5E7FA" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UnoDock.TabHoverBrush" Color="#E4EFFB" />
    <x:String x:Key="UnoDock.DocumentTabShape">Slanted</x:String>
    <x:Boolean x:Key="UnoDock.BoldSelectedTab">True</x:Boolean>
    <x:Double x:Key="UnoDock.TabHorizontalPadding">4</x:Double>

    <LinearGradientBrush x:Key="UnoDock.ToolTitleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#B8CAE0" />
        <GradientStop Offset="1" Color="#E0EAF9" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UnoDock.ToolTabStripBrush" Color="#EDF0FA" />
    <SolidColorBrush x:Key="UnoDock.ToolTabBrush" Color="#EDF0FA" />
    <SolidColorBrush x:Key="UnoDock.SelectedToolTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.ToolTabForegroundBrush" Color="#6D7078" />
    <SolidColorBrush x:Key="UnoDock.RailBrush" Color="#EBEEFA" />
    <LinearGradientBrush x:Key="UnoDock.AnchorTabBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#F6F8FC" />
        <GradientStop Offset="1" Color="#DCE4F1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UnoDock.PaneBorderBrush" Color="#898C95" />
    <SolidColorBrush x:Key="UnoDock.FloatingBorderBrush" Color="#898C95" />
    <SolidColorBrush x:Key="UnoDock.ActiveFloatingBorderBrush" Color="#5A8FD0" />

    <x:Double x:Key="UnoDock.TitleHeight">21</x:Double>
    <x:Double x:Key="UnoDock.TabHeight">23</x:Double>
    <x:Double x:Key="UnoDock.ToolTabHeight">23</x:Double>
</ResourceDictionary>
