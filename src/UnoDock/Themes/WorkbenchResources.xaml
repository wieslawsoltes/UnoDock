<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dock="using:UnoDock" x:Class="UnoDock.Themes.WorkbenchResources">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#D1D1D1"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#1B1B1B"/>
      <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="#606060"/>
      <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="#9B9B9B"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#E9E9E9"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#DDDDDD"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#0067C0"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#FAFAFA"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#272727"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#202020"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#202020"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#454545"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="#C5C5C5"/>
      <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="#858585"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#343434"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#3D3D3D"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#60CDFF"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#2C2C2C"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#272727"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#202020"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#202020"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#454545"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="#C5C5C5"/>
      <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="#858585"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#343434"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#3D3D3D"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#60CDFF"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#2C2C2C"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:Double x:Key="UnoDock.TabCornerRadius">4</x:Double>
  <x:Double x:Key="UnoDock.TabHorizontalPadding">6</x:Double>
  <x:Double x:Key="UnoDock.PaneCornerRadius">4</x:Double>
  <x:Double x:Key="UnoDock.FontSize">12</x:Double>
  <x:Double x:Key="UnoDock.TitleHeight">26</x:Double>
  <x:Double x:Key="UnoDock.TabHeight">28</x:Double>
  <x:Double x:Key="UnoDock.ToolTabHeight">26</x:Double>
  <x:Double x:Key="UnoDock.RailThickness">30</x:Double>
  <x:Double x:Key="UnoDock.ButtonCornerRadius">3</x:Double>
  <x:Double x:Key="UnoDock.Compact.TitleHeight">18</x:Double>
  <x:Double x:Key="UnoDock.Compact.TabHeight">20</x:Double>
  <x:Double x:Key="UnoDock.Compact.ToolTabHeight">23</x:Double>
  <x:Double x:Key="UnoDock.Compact.RailThickness">26</x:Double>
  <x:Double x:Key="UnoDock.Compact.ChromeButtonSize">16</x:Double>
  <x:Double x:Key="UnoDock.Comfortable.TitleHeight">26</x:Double>
  <x:Double x:Key="UnoDock.Comfortable.TabHeight">28</x:Double>
  <x:Double x:Key="UnoDock.Comfortable.ToolTabHeight">26</x:Double>
  <x:Double x:Key="UnoDock.Comfortable.RailThickness">30</x:Double>
  <x:Double x:Key="UnoDock.Comfortable.ChromeButtonSize">20</x:Double>
  <x:Double x:Key="UnoDock.Spacious.TitleHeight">32</x:Double>
  <x:Double x:Key="UnoDock.Spacious.TabHeight">36</x:Double>
  <x:Double x:Key="UnoDock.Spacious.ToolTabHeight">32</x:Double>
  <x:Double x:Key="UnoDock.Spacious.RailThickness">38</x:Double>
  <x:Double x:Key="UnoDock.Spacious.ChromeButtonSize">28</x:Double>
  <x:Double x:Key="UnoDock.ActiveTabIndicatorThickness">2</x:Double>
  <Style x:Key="UnoDock.WorkbenchManagerStyle" TargetType="dock:DockingManager">
    <Setter Property="ChromeDensity" Value="Comfortable"/>
    <Setter Property="Background" Value="{ThemeResource UnoDock.PaneBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource UnoDock.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style x:Key="UnoDock.WorkbenchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
</ResourceDictionary>
