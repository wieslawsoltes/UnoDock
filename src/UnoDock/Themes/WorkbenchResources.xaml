<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dock="using:UnoDock" x:Class="UnoDock.Themes.WorkbenchResources">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#F5F6F8"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#EBEDF1"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#D0D5DE"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#20252D"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#E8EDF5"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#D7E1F0"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#2563EB"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#EFF4FC"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#202329"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#252931"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#2C313B"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#464E5D"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#EDF0F5"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#353D4B"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#414D60"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#8AB4FF"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#2C374A"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#202329"/>
      <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#252931"/>
      <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#2C313B"/>
      <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#464E5D"/>
      <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#EDF0F5"/>
      <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#353D4B"/>
      <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#414D60"/>
      <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#8AB4FF"/>
      <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#2C374A"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:Double x:Key="UnoDock.FontSize">12</x:Double>
  <x:Double x:Key="UnoDock.TitleHeight">26</x:Double>
  <x:Double x:Key="UnoDock.TabHeight">28</x:Double>
  <x:Double x:Key="UnoDock.ToolTabHeight">26</x:Double>
  <x:Double x:Key="UnoDock.RailThickness">30</x:Double>
  <x:Double x:Key="UnoDock.ButtonCornerRadius">3</x:Double>
  <Style x:Key="UnoDock.WorkbenchManagerStyle" TargetType="dock:DockingManager">
    <Setter Property="Background" Value="{ThemeResource UnoDock.PaneBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource UnoDock.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style x:Key="UnoDock.WorkbenchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
</ResourceDictionary>
