<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flat, typographic chrome: white surfaces, hairline pane borders and a
         bar above the selected tab that takes the accent color when active.
         Independently authored palette. -->
    <SolidColorBrush x:Key="UnoDock.PaneBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.HeaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.InactiveTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.BorderBrush" Color="#CCCEDB" />
    <SolidColorBrush x:Key="UnoDock.ForegroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="UnoDock.SecondaryForegroundBrush" Color="#6D6D6D" />
    <SolidColorBrush x:Key="UnoDock.DisabledForegroundBrush" Color="#A2A4A5" />
    <SolidColorBrush x:Key="UnoDock.HoverBrush" Color="#EEEEF2" />
    <SolidColorBrush x:Key="UnoDock.PressedBrush" Color="#DCDCE4" />
    <SolidColorBrush x:Key="UnoDock.AccentBrush" Color="#41B1E1" />
    <SolidColorBrush x:Key="UnoDock.ActiveTitleBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="UnoDock.WorkspaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.SplitterBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabStripBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.SelectedDocumentTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.DocumentTabForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="UnoDock.SelectedDocumentTabForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="UnoDock.ActiveDocumentTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.TabHoverBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="UnoDock.SelectedTabIndicatorBrush" Color="#333333" />
    <SolidColorBrush x:Key="UnoDock.ActiveTabIndicatorBrush" Color="#41B1E1" />
    <x:Double x:Key="UnoDock.ActiveTabIndicatorThickness">3</x:Double>
    <x:String x:Key="UnoDock.TabIndicatorPlacement">Top</x:String>
    <x:Double x:Key="UnoDock.DocumentTabSpacing">6</x:Double>
    <SolidColorBrush x:Key="UnoDock.TabBorderBrush" Color="#00FFFFFF" />
    <x:Double x:Key="UnoDock.TabHorizontalPadding">4</x:Double>

    <SolidColorBrush x:Key="UnoDock.ToolTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.ActiveToolTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.ToolTitleForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="UnoDock.ActiveToolTitleForegroundBrush" Color="#000000" />
    <!-- Caption glyphs stay faint until hovered. -->
    <SolidColorBrush x:Key="UnoDock.CaptionButtonForegroundBrush" Color="#CED4DD" />
    <SolidColorBrush x:Key="UnoDock.ChromeButtonHoverForegroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="UnoDock.ToolTabStripBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.ToolTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.SelectedToolTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.ToolTabForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="UnoDock.SelectedToolTabForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="UnoDock.RailBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.AnchorTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UnoDock.AnchorTabForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="UnoDock.PaneBorderBrush" Color="#CCCEDB" />
    <SolidColorBrush x:Key="UnoDock.FloatingBorderBrush" Color="#CCCEDB" />
    <SolidColorBrush x:Key="UnoDock.ActiveFloatingBorderBrush" Color="#41B1E1" />
    <x:Double x:Key="UnoDock.FloatingBorderThickness">3</x:Double>

    <x:Double x:Key="UnoDock.FontSize">13</x:Double>
    <x:Double x:Key="UnoDock.TitleHeight">24</x:Double>
    <x:Double x:Key="UnoDock.TabHeight">28</x:Double>
    <x:Double x:Key="UnoDock.ToolTabHeight">26</x:Double>
</ResourceDictionary>
