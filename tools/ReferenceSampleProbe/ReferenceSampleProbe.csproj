<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework><UseWPF>true</UseWPF><IsPackable>false</IsPackable><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <ReferenceUsing Include="Controls" />
    <ReferenceUsing Include="Layout" />
    <!-- The companion assembly is named only in contracts/reference.json. -->
    <Reference Include="$(CompanionNamespace)"><HintPath>$(ToolkitAssembly)</HintPath><Private>true</Private></Reference>
    <CompanionAlias Include="PropertyGrid" Type="PropertyGrid.PropertyGrid" />
  </ItemGroup>
  <Import Project="../ReferenceIdentity/ReferenceIdentity.targets" />
</Project>
