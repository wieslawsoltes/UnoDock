<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <Version>0.1.0-preview.1</Version>
    <DebugType>portable</DebugType><Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- NuGet package metadata. These properties only affect `pack`; projects opt out with IsPackable=false. -->
  <PropertyGroup>
    <Authors>Wiesław Šoltés</Authors>
    <Copyright>Copyright © Wiesław Šoltés and UnoDock contributors</Copyright>
    <PackageProjectUrl>https://github.com/wieslawsoltes/UnoDock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wieslawsoltes/UnoDock</RepositoryUrl><RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl><EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>uno;uno-platform;winui;docking;dock;tool-windows;layout;workspace;ide;xaml</PackageTags>
    <PackageReleaseNotes>https://github.com/wieslawsoltes/UnoDock/releases</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols><SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Validates compatible frameworks inside the package. Uno.Sdk libraries pair a generic
         Uno build with a native WinUI build whose API surfaces intentionally differ. -->
    <EnablePackageValidation Condition="'$(UsingUnoSdk)' != 'true'">true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <!-- nuget.org renders the package readme without the repository's relative links. -->
    <None Include="$(MSBuildThisFileDirectory)build/nuget-readme.md" Pack="true" PackagePath="/README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)build/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
